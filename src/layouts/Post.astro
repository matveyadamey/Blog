---
import Base from './Base.astro';
import { url, postCover } from '../lib/paths';
import { formatDate } from '../lib/date';
import { site } from '../site';
import { tocHtml } from '../lib/toc-html.mjs';
import { headingsFromMarkdown } from '../lib/remark-heading-labels.mjs';
import 'katex/dist/katex.min.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
  html?: string;
}

interface Neighbor {
  id: string;
  data: { title: string };
}

const { post, headings, newer, older, minutes } = Astro.props as {
  post: { id: string; body?: string; data: { title: string; date: Date; excerpt?: string; cover?: string } };
  headings: Heading[];
  newer: Neighbor | null;
  older: Neighbor | null;
  minutes: number;
};

const { title, date, excerpt, cover } = post.data;
const coverSrc = postCover(post.id, cover);
const parsed = headingsFromMarkdown(post.body ?? '');
const tocSource = parsed.length ? parsed : headings;

type TocItem = Heading & { children: TocItem[] };
const toc: TocItem[] = [];
for (const h of tocSource) {
  if (h.depth < 1 || h.depth > 3) continue;
  const item: TocItem = { ...h, html: tocHtml(h.text), children: [] };
  const last = toc[toc.length - 1];
  if (last && h.depth > last.depth) last.children.push(item);
  else toc.push(item);
}
---

<Base title={`${title} — ${site.name}`} description={excerpt} image={coverSrc} type="article">
  <div class="progress" data-progress></div>

  <article class="wrap">
    <a class="back mono" href={url()}>← Все посты</a>

    <header class="post-head">
      <div class="meta mono">
        <span class="hl">{formatDate(date)}</span>
        <span class="sep">·</span>
        <span>{minutes} мин</span>
      </div>
      <h1>{title}</h1>
    </header>

    {
      toc.length > 0 && (
        <details class="toc-mobile">
          <summary class="mono">Содержание</summary>
          <nav>
            {toc.map((t) => (
              <>
                <a href={`#${t.slug}`} set:html={t.html} />
                {t.children.map((c) => (
                  <a class="sub" href={`#${c.slug}`} set:html={c.html} />
                ))}
              </>
            ))}
          </nav>
        </details>
      )
    }

    <div class="layout">
      <div class="col">
        <div class="prose"><slot /></div>

        <nav class="prevnext">
          {
            newer && (
              <a class="pn newer" href={url(`posts/${newer.id}/`)}>
                <span class="mono dir">↑ Следующий пост</span>
                <span class="pn-title">{newer.data.title}</span>
              </a>
            )
          }
          {
            older && (
              <a class="pn older" href={url(`posts/${older.id}/`)}>
                <span class="mono dir">Предыдущий пост ↓</span>
                <span class="pn-title">{older.data.title}</span>
              </a>
            )
          }
        </nav>
      </div>

      {
        toc.length > 0 && (
          <aside class="toc">
            <div class="mono toc-title">Содержание</div>
            <nav data-toc-nav>
              {toc.map((t) => (
                <>
                  <a class="toc-link" href={`#${t.slug}`} data-toc-link={t.slug} set:html={t.html} />
                  {t.children.map((c) => (
                    <a class="toc-link sub" href={`#${c.slug}`} data-toc-link={c.slug} set:html={c.html} />
                  ))}
                </>
              ))}
            </nav>
          </aside>
        )
      }
    </div>
  </article>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const links = [...document.querySelectorAll<HTMLElement>('[data-toc-link]')];
  const targets = links
    .map((l) => document.getElementById(l.dataset.tocLink!))
    .filter((el): el is HTMLElement => !!el);

  let ticking = false;
  function update() {
    ticking = false;
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
    if (bar) bar.style.width = pct + '%';

    let active = targets[0];
    for (const t of targets) if (t.getBoundingClientRect().top <= 120) active = t;
    for (const l of links) l.classList.toggle('active', !!active && l.dataset.tocLink === active.id);

    const nav = document.querySelector<HTMLElement>('[data-toc-nav]');
    const current = nav?.querySelector<HTMLElement>('.toc-link.active');
    if (nav && current) {
      const navBox = nav.getBoundingClientRect();
      const linkBox = current.getBoundingClientRect();
      if (linkBox.top < navBox.top) nav.scrollTop -= navBox.top - linkBox.top;
      else if (linkBox.bottom > navBox.bottom) nav.scrollTop += linkBox.bottom - navBox.bottom;
    }
  }
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  }
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll, { passive: true });
  update();
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: #fff;
    z-index: 70;
    transition: width 0.08s linear;
  }

  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 22px 120px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
    font-size: 12px;
    color: var(--fg-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .back:hover {
    color: #fff;
  }

  .post-head {
    padding: 26px 0 30px;
    border-bottom: 1px solid var(--line);
  }
  .meta {
    display: flex;
    gap: 12px;
    font-size: 12px;
    color: var(--fg-dim);
  }
  .meta .hl {
    color: #fff;
  }
  .meta .sep {
    color: rgba(255, 255, 255, 0.3);
  }
  .post-head h1 {
    margin: 20px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 4.6vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--fg);
    text-wrap: balance;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 232px;
    gap: 54px;
    align-items: start;
    margin-top: 36px;
  }
  .col {
    max-width: 740px;
    min-width: 0;
  }

  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 54px;
    border: 1px solid var(--line);
  }
  .pn {
    padding: 18px;
    text-decoration: none;
    color: #fff;
    transition: background 0.15s;
  }
  .pn:first-child:not(:only-child) {
    border-right: 1px solid var(--line);
  }
  .pn:hover {
    background: var(--hover);
  }
  .pn.older {
    grid-column: 2;
    text-align: right;
  }
  .pn .dir {
    display: block;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--fg-faint);
    margin-bottom: 8px;
  }
  .pn-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.18;
  }

  .toc {
    position: sticky;
    top: 24px;
    align-self: start;
    max-height: calc(100vh - 48px);
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .toc-title {
    flex-shrink: 0;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--fg-faint);
    padding-bottom: 14px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--line);
  }
  .toc nav {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 6px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
  }
  .toc nav::-webkit-scrollbar {
    width: 6px;
  }
  .toc nav::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.28);
  }
  .toc-link {
    border-left: 2px solid transparent;
    padding: 7px 0 7px 13px;
    font-size: 14px;
    line-height: 1.35;
    color: var(--fg-dim);
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .toc-link.sub {
    padding: 6px 0 6px 26px;
    font-size: 13px;
  }
  .toc-link:hover {
    color: #fff;
  }
  .toc-link.active {
    color: #fff;
    border-left-color: #fff;
    font-weight: 600;
  }
  .toc :global(.katex),
  .toc-mobile :global(.katex) {
    font-size: 1em;
  }

  .toc-mobile {
    display: none;
    margin: 26px 0 4px;
    border: 1px solid var(--line);
  }
  .toc-mobile summary {
    padding: 15px 16px;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: #fff;
    cursor: pointer;
    list-style: none;
  }
  .toc-mobile nav {
    display: flex;
    flex-direction: column;
    padding: 4px 0 10px;
    border-top: 1px solid var(--line);
  }
  .toc-mobile a {
    padding: 10px 16px;
    font-size: 15px;
    color: var(--fg-dim);
    text-decoration: none;
  }
  .toc-mobile a.sub {
    padding-left: 32px;
    font-size: 14px;
  }

  @media (max-width: 820px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .toc {
      display: none;
    }
    .toc-mobile {
      display: block;
    }
  }

  .prose :global(p) {
    margin: 0 0 22px;
    font-size: 18px;
    line-height: 1.72;
    color: var(--fg-body);
    text-wrap: pretty;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 22px;
    padding-left: 1.5em;
    font-size: 18px;
    line-height: 1.72;
    color: var(--fg-body);
  }
  .prose :global(li) {
    margin: 0 0 10px;
  }
  .prose :global(li::marker) {
    color: var(--fg-faint);
  }
  .prose :global(h2) {
    margin: 52px 0 22px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: var(--fg);
    scroll-margin-top: 24px;
  }
  .prose :global(h3) {
    margin: 38px 0 16px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--fg);
    scroll-margin-top: 24px;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }
  .prose :global(a:hover) {
    text-decoration-color: #fff;
  }
  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 2px 6px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
  }
  .prose :global(blockquote) {
    margin: 0 0 22px;
    padding: 4px 0 4px 18px;
    border-left: 2px solid #fff;
    color: var(--fg-dim);
  }
  .prose :global(.table-wrap) {
    overflow-x: auto;
    margin: 0 0 24px;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.5;
  }
  .prose :global(.table-wrap table) {
    margin: 0;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--line);
    padding: 9px 12px;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    font-weight: 700;
    color: #fff;
    background: rgba(255, 255, 255, 0.03);
  }
  .prose :global(td strong) {
    color: #fff;
    font-weight: 700;
  }
  .prose :global(td .katex),
  .prose :global(th .katex) {
    font-size: 1.05em;
  }
  .prose :global(figure:not([class])) {
    margin: 0 0 26px;
    border: 1px solid var(--line);
  }
  .prose :global(figure:not([class]) img) {
    width: 100%;
    background: var(--bg-deep);
  }
  .prose :global(figure:not([class]) > figcaption) {
    padding: 11px 14px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--fg-dim);
  }
  .prose :global(.expressive-code) {
    margin: 0 0 24px;
  }
  .prose :global(.katex-display) {
    margin: 24px 0;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .prose :global(.callout) {
    --callout: var(--bronze);
    margin: 0 0 24px;
    padding: 16px 18px 14px;
    border: 1px solid var(--line);
    border-left: 2px solid var(--callout);
    background: rgba(255, 255, 255, 0.025);
  }
  .prose :global(.callout--theorem),
  .prose :global(.callout--lemma),
  .prose :global(.callout--corollary),
  .prose :global(.callout--proposition) {
    --callout: #fff;
    background: rgba(255, 255, 255, 0.035);
  }
  .prose :global(.callout--proof) {
    --callout: var(--fg-faint);
    background: transparent;
    border-left-style: dashed;
  }
  .prose :global(.callout--example),
  .prose :global(.callout--remark) {
    --callout: var(--fg-dim);
  }
  .prose :global(.callout--problem) {
    background: rgba(237, 199, 90, 0.045);
  }
  .prose :global(.callout-kicker) {
    margin: 0 0 8px;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--callout);
  }
  .prose :global(.callout-title) {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    color: #fff;
  }
  .prose :global(.callout-title strong) {
    font-weight: 700;
  }
  .prose :global(.callout-title .katex) {
    font-size: 1em;
  }
  .prose :global(.callout + .callout) {
    margin-top: 18px;
  }
  .prose :global(.callout-body) > :last-child {
    margin-bottom: 0;
  }
  .prose :global(.callout-body) > :first-child {
    margin-top: 0;
  }
  .prose :global(.callout p) {
    font-size: 17px;
  }
  .prose :global(.callout-slot) {
    margin-top: 16px;
  }
  .prose :global(.callout-slot:first-child) {
    margin-top: 0;
  }
  .prose :global(.callout-slot > strong:first-child) {
    display: block;
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--callout);
  }
  .prose :global(.callout--proof .callout-body) {
    position: relative;
    padding-bottom: 4px;
  }
  .prose :global(.callout--proof .callout-body)::after {
    content: '□';
    display: block;
    text-align: right;
    margin-top: 8px;
    color: var(--fg-faint);
    font-size: 14px;
    line-height: 1;
  }
</style>
